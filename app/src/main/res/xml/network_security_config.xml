<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Allow cleartext only if Apps Script URL uses HTTP (it won't — Google uses HTTPS) -->
    <!-- This config enforces HTTPS-only for all connections -->
</network-security-config>
