<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- XML base theme using AppCompat (explicit dep in build.gradle.kts).
         Compose handles all Material3 UI — this XML theme only sets window background. -->
    <style name="Theme.TillzoPOS" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
