          case 7: // com.tillzo.pos.data.sync.options.worker.ShardingWorker_AssistedFactory 
          return (T) new ShardingWorker_AssistedFactory() {
            @Override
            public ShardingWorker create(Context context2, WorkerParameters params2) {
              return new ShardingWorker(context2, params2, singletonCImpl.sheetsRepositoryProvider.get());
            }
          };

          case 8: // com.tillzo.pos.data.sync.options.worker.SyncWorker_AssistedFactory 
          return (T) new SyncWorker_AssistedFactory() {
